RewriteEngine On

# Rate-limit state is an application-owned directory, not web content.
RewriteRule ^\.contact-rate-limit(?:/|$) - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=()"
  # The export contains Next hydration scripts and inline React styles. Restrict
  # every other resource class while retaining those required site behaviors.
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self' https://fonts.gstatic.com; form-action 'self'; frame-ancestors 'self'; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; upgrade-insecure-requests"
  # Keep HSTS scoped to this host until every browser-facing subdomain is audited.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always unset X-Powered-By
</IfModule>

# Consolidate the www hostname into the canonical non-www domain.
RewriteCond %{HTTP_HOST} ^www\.flatsix\.media$ [NC]
RewriteRule ^ https://flatsix.media%{REQUEST_URI} [R=301,L,NE]
